PROFILE=full
DATASETS=
TOOLS_MACOS=du,dumac,diskus,dua,dust,nulldisk
TOOLS_LINUX=du,diskus,pdu,gdu,dust,erdtree,ncdu,dua,nulldisk
SWEEP=1
SWEEP_DATASETS=deep,mixed,node_modules
SWEEP_JOBS=1,3,0
SWEEP_WARM=15
SWEEP_COLD=7
SWEEP_RAW="sh=true {path};ndver=nulldisk --version >/dev/null;ndempty=mkdir -p /tmp/e && nulldisk scan /tmp/e --json --depth 0 >/dev/null;dumacempty=mkdir -p /tmp/e && dumac /tmp/e >/dev/null;duempty=mkdir -p /tmp/e && du -s /tmp/e >/dev/null"
